# ============================================================================
# HYPERLIQUID AI TRADING AGENT - CONFIGURATION
# ============================================================================

# -----------------------------------------------------------------------------
# EXCHANGE & WALLET
# -----------------------------------------------------------------------------
HYPERLIQUID_PRIVATE_KEY=0x_your_private_key_here  # Wallet private key (REQUIRED)

# -----------------------------------------------------------------------------
# LLM PROVIDER - Groq (recommended for fast open source inference)
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_key_here  # From https://console.groq.com (REQUIRED)

# LLM Model Selection - Groq models (fast, open source)
# Available models:
#   - llama-3.3-70b-versatile (recommended - best quality)
#   - llama-3.1-70b-versatile (stable)
#   - llama3-70b-8192 (legacy)
#   - mixtral-8x7b-32768 (smaller, faster)
LLM_MODEL="groq/llama-3.3-70b-versatile"

# -----------------------------------------------------------------------------
# ALTERNATIVE: OpenRouter (for access to multiple providers)
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=your_openrouter_key_here  # From https://openrouter.ai
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL="x-ai/grok-4"  # or "anthropic/claude-3.5-sonnet", "openai/gpt-4"

# -----------------------------------------------------------------------------
# TECHNICAL INDICATORS
# -----------------------------------------------------------------------------
TAAPI_API_KEY=your_taapi_key_here  # From https://taapi.io (REQUIRED)

# -----------------------------------------------------------------------------
# ON-CHAIN METRICS (Optional but recommended for BTC/ETH)
# -----------------------------------------------------------------------------
GLASSNODE_API_KEY=your_glassnode_key_here  # From https://glassnode.com
# Note: Glassnode subscription required for advanced metrics
# Free tier available with limited metrics

# -----------------------------------------------------------------------------
# TRADING CONFIGURATION
# -----------------------------------------------------------------------------
# Assets to trade (space or comma separated)
ASSETS="BTC ETH SOL"

# Trading interval (how often to make decisions)
INTERVAL="5m"

# Position sizing (percentage of account per trade)
POSITION_SIZE_PCT=2.0

# Leverage range (dynamic adjustment based on volatility and confidence)
LEVERAGE_MIN=3.0
LEVERAGE_MAX=10.0

# -----------------------------------------------------------------------------
# CAMEL AGENT CONFIGURATION
# -----------------------------------------------------------------------------
# Number of recent trades to keep in memory for learning
MEMORY_TRADES_COUNT=25

# Enable CAMEL agent (set to false to use legacy agent)
USE_CAMEL_AGENT=true

# -----------------------------------------------------------------------------
# RISK MANAGEMENT
# -----------------------------------------------------------------------------
# Maximum portfolio heat (total exposure / account value)
# 0.30 = 30% max exposure (conservative for $5000 accounts)
# 0.50 = 50% max exposure (moderate)
MAX_PORTFOLIO_HEAT=0.30

# Maximum number of simultaneous positions
# Lower values reduce correlation risk
MAX_POSITIONS=3

# -----------------------------------------------------------------------------
# API SERVER (For monitoring dashboard)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080

# -----------------------------------------------------------------------------
# OPTIONAL: ADVANCED SETTINGS
# -----------------------------------------------------------------------------
# Enable reasoning tokens for supported models (e.g., o1, o3)
# REASONING_ENABLED=false
# REASONING_EFFORT=medium  # low, medium, high

# Model provider specific settings
# PROVIDER_CONFIG={}
# PROVIDER_QUANTIZATIONS=[]

# Sanitize model for fixing malformed outputs
# SANITIZE_MODEL=openai/gpt-4o-mini